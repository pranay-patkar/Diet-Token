# Token-Diet — environment variables
# Copy this file to .env and fill in real values. .env is gitignored.

# --- Cross-encoder / model settings ---
# Override the default cross-encoder model (optional)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Force CPU-only inference even if a GPU is available (optional, "true"/"false")
FORCE_CPU=true

# --- Pipeline defaults (optional overrides) ---
# Fraction of sentences BM25 pre-filter keeps before cross-encoder scoring
KEEP_FRACTION=0.6

# Minimum number of sentences BM25 pre-filter will always keep, regardless of keep_fraction
MIN_KEEP=3

# --- Future: API backend (not required for mock-data demo) ---
# Uncomment and fill in if wiring the dashboard to a live /compress endpoint

# API_PORT=8000
# LLM_API_KEY=
# LLM_API_BASE_URL=
