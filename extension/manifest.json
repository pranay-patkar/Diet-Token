{
  "manifest_version": 3,
  "name": "PromptTrim — Dynamic Context Compressor",
  "version": "1.2.0",
  "description": "Squeeze filler out of any prompt before it reaches the LLM. Local two-stage scoring (TF-IDF keywords + semantic n-grams), redundancy removal, live token/cost/latency stats.",
  "permissions": ["storage", "contextMenus", "activeTab", "clipboardWrite"],
  "host_permissions": [
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.openai.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*",
        "https://www.perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://*.poe.com/*",
        "https://chat.mistral.ai/*",
        "https://*.mistral.ai/*",
        "https://huggingface.co/chat*",
        "https://hf.co/chat*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "tokenizer.js",
        "instruction-detector.js",
        "diff.js",
        "engine.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "worker.js",
        "engine.js",
        "tokenizer.js",
        "instruction-detector.js",
        "diff.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptTrim Compressor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "compress-focused": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Compress the focused text box with PromptTrim"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}